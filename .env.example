# Copy to .env.local and fill in real values. .env.local is gitignored.

# --- Supabase ---
# Project URL + anon key (public, safe for the browser):
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (SECRET — server only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# --- DeepSeek (review generation) ---
# https://platform.deepseek.com/api_keys  (SECRET — server only)
DEEPSEEK_API_KEY=

# --- Admin basic-auth password ---
# Username is always "admin". This is the password. (SECRET — server only)
ADMIN_TOKEN=

# --- Public base URL (used to build absolute links / QR content) ---
# Local dev default. In production this MUST be the canonical public origin —
# apex, no trailing slash, e.g. https://onloz.com (never app.onloz.com; the
# /r/... links + QR codes go to customers). NEXT_PUBLIC vars are inlined at
# build time. If unset in a production build, lib/url.ts falls back to
# https://onloz.com rather than leaking localhost.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- App origin (marketing "Log in" target) ---
# Where the core application lives. Leave empty to link to /portal/login in the
# same deployment (local dev). Set to https://app.onloz.com on the marketing site.
NEXT_PUBLIC_APP_URL=

# --- Host-aware routing in proxy.ts ---
# Defaults to app.onloz.com / onloz.com. Only needed if the hostnames differ
# from the defaults (e.g. when testing locally or in preview).
# ONLOZ_APP_HOST=app.onloz.com
# ONLOZ_MARKETING_HOST=onloz.com
